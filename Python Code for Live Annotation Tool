        # Timer setup
        self.timer.timeout.connect(self.update_waveform_cursor)
        # Waveform zooming and double-click
        view_box = self.waveform_plot.getViewBox()
        view_box.setMouseEnabled(x=True, y=True)
        view_box.setLimits(xMin=None, xMax=None, yMin=None, yMax=None)
        def wheelEvent(event, axis=None):
            mouse_pos = view_box.mapSceneToView(event.pos())
            mouse_x, mouse_y = mouse_pos.x(), mouse_pos.y()
            x_range, y_range = view_box.viewRange()
            x_min, x_max = x_range[0], x_range[1]
            y_min, y_max = y_range[0], y_range[1]
            x_span = x_max - x_min
            y_span = y_max - y_min
            zoom_factor = 1.2 if event.delta() < 0 else 1 / 1.2
            new_x_span = x_span * zoom_factor
            new_y_span = y_span * zoom_factor
            new_x_span = max(new_x_span, 0.1)
            new_y_span = max(new_y_span, 0.02)
            x_ratio = (mouse_x - x_min) / x_span
            new_x_min = mouse_x - new_x_span * x_ratio
            new_x_max = mouse_x + new_x_span * (1 - x_ratio)
            clamp_x_min, clamp_x_max = (self.start_time, self.end_time) if self.start_time and self.end_time else (0, self.video_duration)
            if new_x_span > (clamp_x_max - clamp_x_min):
                new_x_span = clamp_x_max - clamp_x_min
                new_x_min = clamp_x_min
                new_x_max = clamp_x_max
            else:
                if new_x_min < clamp_x_min:
                    new_x_min = clamp_x_min
                    new_x_max = new_x_min + new_x_span
                if new_x_max > clamp_x_max:
                    new_x_max = clamp_x_max
                    new_x_min = new_x_max - new_x_span
            y_ratio = (mouse_y - y_min) / y_span
            new_y_min = mouse_y - new_y_span * y_ratio
            new_y_max = mouse_y + new_y_span * (1 - y_ratio)
            view_box.setRange(xRange=(new_x_min, new_x_max), yRange=(new_y_min, new_y_max), padding=0)
        def mouseDoubleClickEvent(event):
            if self.audio_waveform:
                x_min, x_max = (self.start_time, self.end_time) if self.start_time and self.end_time else (0, self.video_duration)
                _, samples = self.audio_waveform
                if samples.size > 0:
                    if self.start_time and self.end_time:
                        time_axis, samples = self.audio_waveform
                        sample_rate = len(time_axis) / self.video_duration if self.video_duration > 0 else1
                        start_idx = int(self.start_time * sample_rate)
                        end_idx = int(self.end_time * sample_rate)
                        start_idx = max(0, min(start_idx, len(samples) - 1))
                        end_idx = max(start_idx, min(end_idx, len(samples)))
                        if start_idx < end_idx:
                            clip_samples = samples[start_idx:end_idx]
                            max_amplitude = np.max(np.abs(clip_samples))
                            max_amplitude = max(max_amplitude * 1.1, 0.1)
                        else:
                            max_amplitude = 0.1
                    else:
                        max_amplitude = np.max(np.abs(samples))
                        max_amplitude = max(max_amplitude * 1.1, 0.1)
                    y_min, y_max = -max_amplitude, max_amplitude
                else:
                    y_min, y_max = -1, 1
                view_box.setRange(xRange=(x_min, x_max), yRange=(y_min, y_max), padding=0)
        view_box.wheelEvent = wheelEvent
        view_box.mouseDoubleClickEvent = mouseDoubleClickEvent
