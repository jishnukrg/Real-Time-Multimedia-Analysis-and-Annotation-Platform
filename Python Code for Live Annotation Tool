    def load_speech_types(self):
        default_speech_types = ["", "Vowel - ehh", "Vowel - ahh", "Sentences", "Rainbow Passage"]
        try:
            if os.path.exists(self.global_config_file):
                with open(self.global_config_file, 'r') as f:
                    data = json.load(f)
                    return data.get("speech_types", default_speech_types)
            else:
                return default_speech_types
        except (json.JSONDecodeError, IOError):
            return default_speech_types

    def save_speech_types(self):
        try:
            with open(self.global_config_file, 'w') as f:
                json.dump({"speech_types": self.speech_types}, f, indent=4)
        except IOError as e:
            QMessageBox.warning(self, "Error", f"Failed to save speech types: {str(e)}")

    def load_user_config(self):
        default_config = {"default_folder": str(Path.home())}
        try:
            if self.user_config_file.exists():
                with open(self.user_config_file, 'r') as f:
                    data = json.load(f)
                    return data
            else:
                return default_config
        except (json.JSONDecodeError, IOError):
            return default_config

    def save_user_config(self, folder_path):
        config = {"default_folder": folder_path}
        try:
            with open(self.user_config_file, 'w') as f:
                json.dump(config, f, indent=4)
        except IOError as e:
            QMessageBox.warning(self, "Error", f"Failed to save user config: {str(e)}")
    def load_default_folder(self):
        config = self.load_user_config()
        default_folder = config.get("default_folder")
        try:
            if default_folder and os.path.isdir(default_folder):
                self.folder = default_folder
                self.trimmed_folder = os.path.join(self.folder, "TrimmedClips")
                os.makedirs(self.trimmed_folder, exist_ok=True)
                self.file_list = [f for f in os.listdir(self.folder) if f.endswith(".mp4") and os.path.isfile(os.path.join(self.folder, f))]
                if self.file_list:
                    self.file_list_widget.clear()
                    for file_name in self.file_list:
                        item = QListWidgetItem(file_name)
                        item.setData(Qt.ItemDataRole.UserRole, file_name)  # Updated to ItemDataRole.UserRole
                        self.file_list_widget.addItem(item)
                else:
                    print(f"No .mp4 files found in default folder: {self.folder}")
            else:
                print(f"Default folder not set or invalid: {default_folder}")
        except (PermissionError, OSError) as e:
            QMessageBox.warning(self, "Folder Error", f"Cannot access default folder: {str(e)}")
    def load_folder(self):
        folder = QFileDialog.getExistingDirectory(self, "Select Folder", self.load_user_config().get("default_folder", ""))
        if folder:
            try:
                self.folder = folder
                self.trimmed_folder = os.path.join(self.folder, "TrimmedClips")
                os.makedirs(self.trimmed_folder, exist_ok=True)
                self.file_list = [f for f in os.listdir(self.folder) if f.endswith(".mp4") and os.path.isfile(os.path.join(self.folder, f))]
                self.file_list_widget.clear()
                for file_name in self.file_list:
                    item = QListWidgetItem(file_name)
                    item.setData(Qt.ItemDataRole.UserRole, file_name)  # Updated to ItemDataRole.UserRole
                    self.file_list_widget.addItem(item)
                self.save_user_config(folder)
                self.load_all_annotations()
                print(f"Default folder set to: {folder}")
            except (PermissionError, OSError) as e:
                QMessageBox.warning(self, "Folder Error", f"Cannot access folder: {str(e)}")
    def load_all_annotations(self):
        self.annotations = []
        annotations_file = os.path.join(self.folder, "annotations.xlsx")
        if os.path.exists(annotations_file):
            try:
                df = pd.read_excel(annotations_file)
                for index, row in df.iterrows():
                    clip_info = [
                        row["Start Time"], row["End Time"], row["Exam Type"],
                        row["Scope Type"], row["Light Type"], row["Speech Type"],
                        row["Clip File"], row["Source File"]
                    ]
                    self.annotations.append(clip_info)
                print(f"Loaded {len(self.annotations)} annotations from {annotations_file}")
            except Exception as e:
                print(f"Error loading annotations: {str(e)}")
        else:
            print(f"No annotations file found at: {annotations_file}")
    def load_clips(self):
        self.clip_list.clear()
        if not self.current_file:
            print("No current file selected, cannot load clips.")
            return
        current_source_file = os.path.basename(self.current_file)
        print(f"Loading clips for source file: {current_source_file}")
        print(f"Total annotations: {len(self.annotations)}")
        for index, clip in enumerate(self.annotations):
            if clip[7] == current_source_file:
                item = QListWidgetItem(clip[6])
                item.setData(Qt.ItemDataRole.UserRole, index)  # Updated to ItemDataRole.UserRole
                self.clip_list.addItem(item)
                print(f"Added clip: {clip[6]}")
    def select_clip(self, item):
        index = item.data(Qt.ItemDataRole.UserRole)  # Updated to ItemDataRole.UserRole
        clip = self.annotations[index]
        self.start_time = clip[0]
        self.end_time = clip[1]
        self.video_dropdown.setCurrentText(clip[2])
        self.scope_dropdown.setCurrentText(clip[3])
        self.light_dropdown.setCurrentText(clip[4])
        self.speech_dropdown.setCurrentText(clip[5])
        self.start_marker.setPos(self.start_time)
        self.start_marker.setVisible(True)
        self.end_marker.setPos(self.end_time)
        self.end_marker.setVisible(True)
        self.player.setPosition(int(self.start_time * 1000))
        self.edit_button.setEnabled(True)
        self.delete_button.setEnabled(True)
       
        if self.audio_waveform:
            self.waveform_plot.setXRange(self.start_time, self.end_time, padding=0)
            time_axis, samples = self.audio_waveform
            sample_rate = len(time_axis) / self.video_duration if self.video_duration > 0 else 1
            start_idx = int(self.start_time * sample_rate)
            end_idx = int(self.end_time * sample_rate)
            start_idx = max(0, min(start_idx, len(samples) - 1))
            end_idx = max(start_idx, min(end_idx, len(samples)))
            if start_idx < end_idx:
                clip_samples = samples[start_idx:end_idx]
                max_amplitude = np.max(np.abs(clip_samples))
                max_amplitude = max(max_amplitude * 1.1, 0.1)
                self.waveform_plot.setYRange(-max_amplitude, max_amplitude, padding=0)
            else:
                self.waveform_plot.setYRange(-0.1, 0.1, padding=0)
    def edit_clip(self):
        selected_items = self.clip_list.selectedItems()
        if not selected_items:
            return
        item = selected_items[0]
        index = item.data(Qt.ItemDataRole.UserRole)  # Updated to ItemDataRole.UserRole
        clip = self.annotations[index]
        dialog = QDialog(self)
        dialog.setWindowTitle("Edit Clip")
        layout = QGridLayout(dialog)
        layout.addWidget(QLabel("Start Time:"), 0, 0)
        start_input = QLineEdit(str(clip[0]))
        start_input.setReadOnly(True)
        layout.addWidget(start_input, 0, 1)
        layout.addWidget(QLabel("End Time:"), 1, 0)
        end_input = QLineEdit(str(clip[1]))
        end_input.setReadOnly(True)
        layout.addWidget(end_input, 1, 1)

        layout.addWidget(QLabel("Exam Type:"), 2, 0)
        video_edit = QComboBox()
        video_edit.addItems(["", "Endoscopic Exam", "Acoustic Exam", "Audio Only"])
        video_edit.setCurrentText(clip[2])
        layout.addWidget(video_edit, 2, 1)
        layout.addWidget(QLabel("Scope Type:"), 3, 0)
        scope_edit = QComboBox()
        scope_edit.addItems(["", "Rigid", "Flexible"])
        scope_edit.setCurrentText(clip[3])
        layout.addWidget(scope_edit, 3, 1)
        layout.addWidget(QLabel("Light Type:"), 4, 0)
        light_edit = QComboBox()
        light_edit.addItems(["", "Strobe", "Halogen"])
        light_edit.setCurrentText(clip[4])
        layout.addWidget(light_edit, 4, 1)
        layout.addWidget(QLabel("Speech Type:"), 5, 0)
        speech_edit = QComboBox()
        speech_edit.addItems(self.speech_types + ["<new>"])
        speech_edit.setCurrentText(clip[5])
        layout.addWidget(speech_edit, 5, 1)
        save_btn = QPushButton("Save")
        save_btn.clicked.connect(lambda: self.save_edited_clip(dialog, index, start_input.text(), end_input.text(),
                                                              video_edit.currentText(), scope_edit.currentText(),
                                                              light_edit.currentText(), speech_edit.currentText()))
        layout.addWidget(save_btn, 6, 0)
        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(dialog.reject)
        layout.addWidget(cancel_btn, 6, 1)
        dialog.exec()
    def save_edited_clip(self, dialog, index, start_str, end_str, video, scope, light, speech):
        try:
            clip = self.annotations[index]
            start_time = clip[0]
            end_time = clip[1]
            clip[0] = start_time
            clip[1] = end_time
            clip[2] = video
            clip[3] = scope
            clip[4] = light
            clip[5] = speech
            self.export_annotations()
            self.load_clips()
            dialog.accept()
        except ValueError:
            QMessageBox.warning(self, "Invalid Input", "An unexpected error occurred.")
    def delete_clip(self):
        selected_items = self.clip_list.selectedItems()
        if not selected_items:
            return
        item = selected_items[0]
        index = item.data(Qt.ItemDataRole.UserRole)  # Updated to ItemDataRole.UserRole
        clip_file = self.annotations[index][6]
        exam_type = self.annotations[index][2]
        reply = QMessageBox.question(self, "Confirm Delete", f"Delete clip {clip_file}?",
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply == QMessageBox.StandardButton.Yes:
            extension = ".wav" if exam_type == "Audio Only" else ".mp4"
            clip_path = os.path.join(self.trimmed_folder, f"{clip_file}{extension}")
            try:
                if os.path.exists(clip_path):
                    os.remove(clip_path)
                    print(f"Deleted file: {clip_path}")
                else:
                    print(f"File not found, removing from annotations anyway: {clip_path}")
            except Exception as e:
                print(f"Error deleting file {clip_path}: {str(e)}")
           
            del self.annotations[index]
            self.export_annotations()
            self.load_clips()
            self.start_marker.setVisible(False)
            self.end_marker.setVisible(False)
            self.edit_button.setEnabled(False)
            self.delete_button.setEnabled(False)
    def handle_speech_type_selection(self, selected_text):
        if selected_text == "<new>":
            new_speech_type, ok = QInputDialog.getText(self, "New Speech Type", "Enter a new speech type:")
            if ok and new_speech_type.strip():
                if new_speech_type not in self.speech_types:
                    self.speech_types.append(new_speech_type)
                    self.save_speech_types()
                    self.update_speech_dropdown(new_speech_type)
                else:
                    QMessageBox.warning(self, "Duplicate", "This speech type already exists.")
            else:
                self.speech_dropdown.setCurrentIndex(0)
        elif selected_text:
            print(f"Selected speech type: {selected_text}")

    def update_speech_dropdown(self, new_selection):
        self.speech_dropdown.blockSignals(True)
        self.speech_dropdown.clear()
        self.speech_dropdown.addItems(self.speech_types + ["<new>"])
        self.speech_dropdown.setCurrentText(new_selection)
        self.speech_dropdown.blockSignals(False)
    def update_dropdown_states(self, selected_text):
        if selected_text in ["Acoustic Exam", "Audio Only"]:
            self.scope_dropdown.setEnabled(False)
            self.light_dropdown.setEnabled(False)
            self.scope_dropdown.setStyleSheet("QComboBox:disabled { color: gray; } QComboBox { color: black; }")
            self.light_dropdown.setStyleSheet("QComboBox:disabled { color: gray; } QComboBox { color: black; }")
            self.speech_dropdown.setEnabled(True)
            self.speech_dropdown.setStyleSheet("QComboBox { color: black; }")
            self.scope_label.setStyleSheet("QLabel { color: gray; }")
            self.light_label.setStyleSheet("QLabel { color: gray; }")
            self.speech_label.setStyleSheet("QLabel { color: black; }")
        else:
            self.scope_dropdown.setEnabled(True)
            self.light_dropdown.setEnabled(True)
            self.speech_dropdown.setEnabled(True)
            self.scope_dropdown.setStyleSheet("QComboBox { color: black; }")
            self.light_dropdown.setStyleSheet("QComboBox { color: black; }")
            self.speech_dropdown.setStyleSheet("QComboBox { color: black; }")
            self.scope_label.setStyleSheet("QLabel { color: black; }")
            self.light_label.setStyleSheet("QLabel { color: black; }")
            self.speech_label.setStyleSheet("QLabel { color: black; }")
    def update_start_time(self):
        self.start_time = max(0, self.start_marker.value())
        print(f"Start time updated: {self.start_time:.2f} seconds")
        self.player.setPosition(int(self.start_time * 1000))
    def update_end_time(self):
        self.end_time = max(self.start_time if self.start_time is not None else 0, self.end_marker.value())
        print(f"End time updated: {self.end_time:.2f} seconds")
        self.player.setPosition(int(self.end_time * 1000))
    def select_file(self, item):
        if item is not None:
            file_name = item.data(Qt.ItemDataRole.UserRole)  # Updated to ItemDataRole.UserRole
            print(f"Selected file: {file_name}")
            self.player.stop()
            self.current_file = os.path.join(self.folder, file_name)
            print(f"Current file set to: {self.current_file}")
            self.play_pause_action.setEnabled(True)
            self.mark_start_action.setEnabled(True)
            self.mark_end_action.setEnabled(True)
            self.export_clip_action.setEnabled(True)
            self.rotate_action.setEnabled(True)
            self.start_marker.setVisible(False)
            self.end_marker.setVisible(False)
            self.start_time = None
            self.end_time = None
            self.load_clips()
           
            self.player.setSource(QUrl.fromLocalFile(self.current_file))
            self.player.durationChanged.connect(self.set_video_duration)
            self.extract_audio_waveform()
            if self.audio_waveform:
                self.waveform_plot.setXRange(0, self.video_duration, padding=0)
                _, samples = self.audio_waveform
                if samples.size > 0:
                    max_amplitude = np.max(np.abs(samples))
                    max_amplitude = max(max_amplitude * 1.1, 0.1)
                    self.waveform_plot.setYRange(-max_amplitude, max_amplitude, padding=0)
                else:
                    self.waveform_plot.setYRange(-1, 1, padding=0)
    def set_video_duration(self, duration):
        self.video_duration = duration / 1000.0
        print(f"Video duration set to: {self.video_duration:.2f} seconds")
    def toggle_play_pause(self):
        if not self.current_file:
            QMessageBox.warning(self, "No File", "Please select a file to play.")
            return
        if self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.player.pause()
            self.timer.stop()
            self.play_pause_action.setIcon(QApplication.style().standardIcon(QStyle.StandardPixmap.SP_MediaPlay))
            self.play_pause_action.setText("Play")
        else:
            self.player.play()
            self.timer.start(30)
            self.play_pause_action.setIcon(QApplication.style().standardIcon(QStyle.StandardPixmap.SP_MediaPause))
            self.play_pause_action.setText("Pause")
    def update_waveform_cursor(self):
        current_time = self.player.position() / 1000.0
        self.cursor.setPos(current_time)
        if self.player.playbackState() == QMediaPlayer.PlaybackState.StoppedState:
            self.timer.stop()

    def extract_audio_waveform(self):
        if not self.current_file:
            print("No current file to extract waveform.")
            return
        print(f"Extracting waveform for: {self.current_file}")
        try:
            stream = ffmpeg.input(self.current_file)
            stream = stream.output('pipe:', format='wav', acodec='pcm_s16le', loglevel="quiet")
            out, _ = ffmpeg.run(stream, capture_stdout=True)
            audio = AudioSegment.from_file(io.BytesIO(out), format="wav")
            samples = np.array(audio.get_array_of_samples())
            samples = samples.astype(np.float32) / np.iinfo(audio.array_type).max
            audio_duration = len(samples) / audio.frame_rate
            if abs(audio_duration - self.video_duration) > 0.1:
                print(f"Warning: Audio duration ({audio_duration:.2f}s) differs from video ({self.video_duration:.2f}s)")
            time_axis = np.linspace(0, self.video_duration, num=len(samples))
            print(f"Waveform samples length: {len(samples)}, time_axis length: {len(time_axis)}")
            self.waveform_curve.setData(time_axis, samples)
            self.audio_waveform = (time_axis, samples)
            self.waveform_plot.setXRange(0, self.video_duration, padding=0)
            if samples.size > 0:
                max_amplitude = np.max(np.abs(samples))
                max_amplitude = max(max_amplitude * 1.1, 0.1)
                self.waveform_plot.setYRange(-max_amplitude, max_amplitude, padding=0)
            else:
                self.waveform_plot.setYRange(-1, 1, padding=0)
        except ffmpeg.Error as e:
            QMessageBox.critical(self, "FFmpeg Error", f"Error extracting audio: {str(e.stderr.decode() if e.stderr else e)}")
        except Exception as e:
            QMessageBox.critical(self, "Waveform Error", f"Unexpected error: {str(e)}")
    def mark_start(self):
        self.start_time = self.player.position() / 1000.0
        if self.start_time is not None:
            print(f"Start marked: {self.start_time:.2f} seconds")
            self.start_marker.setVisible(True)
            self.start_marker.setPos(self.start_time)
    def mark_end(self):
        self.end_time = self.player.position() / 1000.0
        if self.end_time is not None:
            print(f"End marked: {self.end_time:.2f} seconds")
            self.end_marker.setVisible(True)
            self.end_marker.setPos(self.end_time)
    def save_clip_and_export(self):
        if self.start_time is None or self.end_time is None or self.start_time >= self.end_time:
            QMessageBox.warning(self, "Invalid Selection", "Please select valid start and end points.")
            return
        file_path = os.path.join(self.folder, self.current_file)
        source_file = os.path.basename(self.current_file)
        video = self.video_dropdown.currentText()
        scope = self.scope_dropdown.currentText()
        light = self.light_dropdown.currentText()
        speech = self.speech_dropdown.currentText()
        try:
            source_base = os.path.splitext(source_file)[0]
            if video == "Audio Only":
                clip_name_base = f"audio_{source_base}_{self.start_time:.2f}_{self.end_time:.2f}"
                output_file = os.path.join(self.trimmed_folder, f"{clip_name_base}.wav")
                stream = ffmpeg.input(file_path, ss=self.start_time, t=self.end_time - self.start_time)
                stream = ffmpeg.output(stream, output_file, format='wav', acodec='pcm_s16le', loglevel="quiet")
                ffmpeg.run(stream, overwrite_output=True)
                QMessageBox.information(self, "Success", f"Audio clip saved to TrimmedClips as {clip_name_base}")
            else:
                clip_name_base = f"clip_{source_base}_{self.start_time:.2f}_{self.end_time:.2f}"
                output_file = os.path.join(self.trimmed_folder, f"{clip_name_base}.mp4")
                stream = ffmpeg.input(file_path, ss=self.start_time, t=self.end_time - self.start_time)
                stream = ffmpeg.output(stream, output_file, c='copy', loglevel="quiet")
                ffmpeg.run(stream, overwrite_output=True)
                QMessageBox.information(self, "Success", f"Video clip saved to TrimmedClips as {clip_name_base}")
            self.annotations.append([self.start_time, self.end_time, video, scope, light, speech, clip_name_base, source_file])
            self.export_annotations()
            self.load_clips()
        except ffmpeg.Error as e:
            QMessageBox.critical(self, "Error", f"Failed to save clip: {str(e.stderr.decode() if e.stderr else e)}")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"An unexpected error occurred: {str(e)}")
    def export_annotations(self):
        try:
            df = pd.DataFrame(self.annotations, columns=[
                "Start Time", "End Time", "Exam Type", "Scope Type", "Light Type", "Speech Type", "Clip File", "Source File"
            ])
            df.to_excel(os.path.join(self.folder, "annotations.xlsx"), index=False)
            print(f"Annotations updated in {os.path.join(self.folder, 'annotations.xlsx')}")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to update annotations.xlsx: {str(e)}")
    def close_application(self):
        self.timer.stop()
        self.player.stop()
        QApplication.quit()
    def rotate_video(self):
        self.rotation_angle = (self.rotation_angle + 90) % 360
